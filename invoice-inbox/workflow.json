    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const bin = item.binary || {};\n  const from = item.json.from;\n  let n = 0;\n  for (const key of Object.keys(bin)) {\n    if (n >= 10) break; // hard cap: 10 PDFs per email\n    const b = bin[key];\n    const isPdf = (b.mimeType || '').includes('pdf') || (b.fileName || '').toLowerCase().endsWith('.pdf');\n    if (!isPdf) continue;\n    n++;\n    out.push({\n      json: {\n        messageId: item.json.id,\n        rowKey: n === 1 ? item.json.id : item.json.id + '#' + n,\n        subject: item.json.subject || '',\n        from: (from && (from.text || from)) || '',\n        fileName: b.fileName || ''\n      },\n      binary: { data: b }\n    });\n  }\n}\nreturn out;"
      },
      "name": "Select PDF attachment",
      "type": "n8n-nodes-base.code",
      "id": "n2",
      "position": [
        304,
        96
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const pdfs = $('Select PDF attachment').all();\nconst now = new Date();\nconst todayUTC = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());\n\nreturn $input.all().map((item, i) => {\n  const src = pdfs[i] ? pdfs[i].json : {};\n  const j = item.json;\n  const where = 'email \"' + src.subject + '\" (' + src.fileName + ')';\n  if (j.status !== 'succeeded') {\n    throw new Error('Replicate prediction did not finish (status: ' + j.status + ') for ' + where + ': ' + (j.error || 'no error message'));\n  }\n  let raw = Array.isArray(j.output) ? j.output.join('') : String(j.output ?? '');\n  raw = String(raw).replace(/```json|```/gi, '').trim();\n\n  let d;\n  try { d = JSON.parse(raw); }\n  catch (e) { throw new Error('Replicate returned invalid JSON for ' + where + ': ' + raw.slice(0, 200)); }\n  if (!d || typeof d !== 'object') {\n    throw new Error('Replicate returned no JSON object for ' + where + ': ' + raw.slice(0, 200));\n  }\n\n  const base = {\n    messageId: src.messageId,\n    rowKey: src.rowKey,\n    fileName: src.fileName,\n    subject: src.subject,\n    from: src.from,\n    processedAt: now.toISOString()\n  };\n\n  // Anything the model did not clearly mark as an invoice goes to the Review tab.\n  if (d.is_invoice !== true) {\n    return { json: { ...base, isInvoice: false, reviewStatus: 'Not an invoice', vendor: d.vendor ? String(d.vendor).trim() : '', invoiceNumber: '', totalAmount: '', currency: '' } };\n  }\n\n  const rawAmount = String(d.total_amount ?? '').trim();\n  const amount = Number(rawAmount.replace(/[^0-9.\\-]/g, ''));\n  if (!d.vendor || rawAmount === '' || !Number.isFinite(amount)) {\n    throw new Error('Could not read vendor/total from invoice in ' + where);\n  }\n\n  let dueDate = null, daysUntilDue = null;\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(d.due_date || ''));\n  if (m) {\n    dueDate = m[0];\n    daysUntilDue = Math.round((Date.UTC(+m[1], +m[2] - 1, +m[3]) - todayUTC) / 86400000);\n  }\n\n  return {\n    json: {\n      ...base,\n      isInvoice: true,\n      vendor: String(d.vendor).trim(),\n      invoiceNumber: d.invoice_number ? String(d.invoice_number).trim() : '',\n      totalAmount: amount,\n      currency: d.currency ? String(d.currency).toUpperCase() : '',\n      dueDate,\n      daysUntilDue,\n      dueSoon: daysUntilDue !== null && daysUntilDue <= 7\n    }\n  };\n});"
      },
