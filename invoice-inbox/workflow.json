    {
      "parameters": {
        "jsCode": "const label = $input.all().find(l => l.json.name === 'Invoices/Processed');\nif (!label) {\n  throw new Error('Gmail label \"Invoices/Processed\" does not exist. Create it in Gmail, then re-run.');\n}\nreturn $('Log invoice to Invoice Log').all().map(r => {\n  const x = r.json;\n  const key = String(x['Message ID'] || '');\n  const raw = x['Days Until Due'];\n  const days = (raw === '' || raw === null || raw === undefined) ? null : Number(raw);\n  return {\n    json: {\n      messageId: key.split('#')[0],\n      rowKey: key,\n      vendor: x['Vendor'],\n      invoiceNumber: x['Invoice Number'],\n      totalAmount: x['Total Amount'],\n      currency: x['Currency'],\n      dueDate: x['Due Date'] || null,\n      daysUntilDue: days,\n      dueSoon: days !== null && Number.isFinite(days) && days <= 7,\n      labelId: label.json.id\n    }\n  };\n});"
      },
