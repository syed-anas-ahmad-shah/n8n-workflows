    {
      "parameters": {
        "jsCode": "const src = $('Get Resume URL (Fact Check)').item.json;\nconst body = items[0].json.body || items[0].json;\nconst output = body?.output;\nlet parsed = null;\nlet success = false;\nlet error = null;\ntry {\n  const raw = Array.isArray(output) ? output.join('') : output;\n  const text = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  parsed = JSON.parse(text);\n  success = true;\n} catch (e) {\n  error = 'Failed to parse fact-check output: ' + e.message;\n}\nreturn [{ json: { job_type: 'fact_check', success, data: parsed, error, retryable: !success, topic: src.topic, depth: src.depth, image_url: src.image_url } }];"
