        "jsCode": "const src = $('Prepare Search').item.json;\nconst results = items[0].json?.query?.search || [];\nconst success = results.length > 0;\nconst data = results.map(r => ({ title: r.title, snippet: String(r.snippet || '').replace(/<[^>]+>/g, '') }));\nreturn [{ json: { job_type: 'search', success, data, error: success ? null : 'No Wikipedia results found', retryable: false, topic: src.topic, depth: src.depth, image_url: src.image_url } }];"
